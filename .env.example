# =============================================================
# IT Helpdesk Ticketing System — AWS Configuration
# =============================================================
# Copy to .env and fill in your values. DO NOT commit .env.

# --- Database (RDS MySQL or local MySQL on EC2) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=it_helpdesk
DB_USER=helpdesk_admin
DB_PASS=CHANGE_ME_STRONG_PASSWORD

# For Amazon RDS, use the endpoint from the RDS console:
# DB_HOST=it-helpdesk-db.xxxxxxxxxxxx.ap-southeast-1.rds.amazonaws.com

# --- OpenAI API ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- AWS S3 (optional — for ticket attachments) ---
AWS_S3_BUCKET=
AWS_S3_REGION=ap-southeast-1
AWS_S3_KEY=
AWS_S3_SECRET=

# --- Application ---
APP_ENV=production
APP_DEBUG=false
APP_URL=http://your-ec2-public-ip
APP_TIMEZONE=Asia/Singapore
